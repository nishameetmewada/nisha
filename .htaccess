DirectoryIndex index.php
Options -Indexes

# Preserve bearer authentication when PHP runs through a CGI/LSAPI handler.
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "^(Bearer .+)$" HTTP_AUTHORIZATION=$1
</IfModule>

# Keep source-control, deployment documentation, and database exports private.
<FilesMatch "(^\.|\.(?:sql|log|ini|env|md|zip)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
